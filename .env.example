# Neon pooled Postgres URL. Add this in Vercel's Environment Variables too.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler/DB?sslmode=require"

# Required by Vercel Blob. Create a Blob store in your Vercel project to get it.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret"
# A password for the one-time /api/bootstrap seeding call. openssl rand -hex 16
BOOTSTRAP_TOKEN="change-me-to-a-random-token"

ADMIN_EMAIL="admin"
ADMIN_PASSWORD="Kindred123"
ADMIN_NAME="Farm Admin"

NEXT_PUBLIC_SITE_NAME="GreenRoots Organic Farm"
